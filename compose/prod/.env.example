SHIFTCONTROL_DOMAIN=shiftcontrol.example.com
SHIFTCONTROL_KEYCLOAK_DOMAIN=keycloak.shiftcontrol.example.com
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
POSTGRES_USER=shiftcontrol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiftservice
NOTIFICATIONSERVICE_POSTGRES_DB=notificationservice
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=shiftcontrol
RABBITMQ_DEFAULT_PASS=change-me
# Optional shared internal API key for Shiftservice machine-to-machine calls.
# When set, notificationservice and trustservice prefer this over OAuth.
SHIFTCONTROL_INTERNAL_API_KEY=
# Shared service-to-service OAuth2 client secret for the Keycloak client
# `internal`. Must match the secret rendered into config/realm.rendered.json.
# Used by internal callers such as notificationservice and trustservice.
KEYCLOAK_INTERNAL_CLIENT_SECRET=change-me
SMTP_PASSWORD=change-me
