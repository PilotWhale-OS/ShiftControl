{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "NotificationService.Service": "Debug"
    }
  },
  "SignalR": {
    "HostPort": 8080,
    "AllowedOrigins": [
      "https://shiftcontrol.example.com"
    ]
  },
  "Jwt": {
    "Authority": "http://keycloak:8080/realms/prod",
    "Issuers": [
      "http://keycloak:8080/realms/prod",
      "https://keycloak.shiftcontrol.example.com/realms/prod"
    ]
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "shiftcontrol",
    "Password": "change-me"
  },
  "Db": {
